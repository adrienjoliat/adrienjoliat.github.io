---
const links = [
  {
    label: 'LinkedIn',
    description: 'Connect with me professionally',
    href: 'https://www.linkedin.com/in/adrien-joliat/',
    type: 'linkedin',
  },
  {
    label: 'GitHub',
    description: 'Explore my code and current projects',
    href: 'https://github.com/adrienjoliat',
    type: 'github',
  },
];
---

<section
  id="contact"
  class="contact section shell reveal"
  aria-labelledby="contact-title"
>
  <div class="section-heading">
    <span>05.</span>
    <h3 id="contact-title">Contact</h3>
  </div>

  <div class="contact-content">
    <p class="contact-eyebrow">Let's connect</p>

    <h4>
      Interested in my work?
      <br />
      I'd be happy to connect.
    </h4>

    <p class="contact-copy">
      The best ways to reach me or follow my work are through LinkedIn and GitHub.
    </p>

    <div class="contact-links">
      {links.map((link) => (
        <a
          class="contact-link"
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="contact-icon">
            {link.type === 'linkedin' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M6.5 8.3H3.2V19H6.5V8.3ZM4.85 3A1.92 1.92 0 1 0 4.85 6.84 1.92 1.92 0 0 0 4.85 3ZM19.8 12.86c0-3.22-1.72-4.72-4.02-4.72-1.86 0-2.69 1.02-3.15 1.74V8.3H9.34V19h3.29v-5.3c0-1.4.27-2.76 2-2.76 1.7 0 1.72 1.59 1.72 2.85V19h3.3l.15-6.14Z"
                />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.85.09-.66.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.35 9.35 0 0 1 12 6.93a9.3 9.3 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.8 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"
                />
              </svg>
            )}
          </div>

          <div>
            <strong>{link.label}</strong>
            <span>{link.description}</span>
          </div>

          <svg class="contact-arrow" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M14 5h5v5M10 14 19 5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      ))}
    </div>
  </div>

  <footer class="portfolio-footer">
    <span>Adrien Joliat</span>
    <span>Computational Scientist & Machine Learning Engineer</span>
  </footer>
</section>

<style>
  .contact {
    min-height: 85vh;
    padding-top: 9rem;
    padding-bottom: 2.5rem;
    scroll-margin-top: var(--nav-height);
    display: flex;
    flex-direction: column;
  }

  .contact-content {
    width: min(100%, 720px);
    margin: auto;
    padding: 5rem 0;
    text-align: center;
  }

  .contact-eyebrow {
    margin: 0 0 .9rem;
    color: var(--accent);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .72rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .contact h4 {
    margin: 0;
    color: #e4edf8;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -.05em;
    font-weight: 680;
  }

  .contact-copy {
    max-width: 530px;
    margin: 1.4rem auto 0;
    color: #8090a7;
    font-size: .95rem;
    line-height: 1.7;
  }

  .contact-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .8rem;
    margin-top: 2.4rem;
  }

  .contact-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: .9rem;
    align-items: center;
    padding: 1rem 1.1rem;
    text-align: left;
    border: 1px solid rgba(114,183,255,.12);
    border-radius: 8px;
    background: rgba(10,24,47,.32);
    transition:
      transform .2s ease,
      border-color .2s ease,
      background .2s ease;
  }

  .contact-link:hover {
    transform: translateY(-3px);
    border-color: rgba(100,255,218,.3);
    background: rgba(100,255,218,.035);
  }

  .contact-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    color: var(--accent);
  }

  .contact-icon svg {
    width: 22px;
    height: 22px;
  }

  .contact-link strong {
    display: block;
    color: #cfd9e7;
    font-size: .82rem;
    font-weight: 600;
  }

  .contact-link span {
    display: block;
    margin-top: .2rem;
    color: #62758d;
    font-size: .66rem;
  }

  .contact-arrow {
    width: 17px;
    color: #52677f;
  }

  .contact-cv {
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    margin-top: 1.5rem;
    color: #8799af;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .67rem;
    transition: color .2s ease;
  }

  .contact-cv:hover {
    color: var(--accent);
  }

  .contact-cv span {
    color: #52677f;
    font-size: .57rem;
  }

  .portfolio-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(148,163,184,.07);
    color: #465970;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .58rem;
  }

  @media (max-width: 650px) {
    .contact {
      min-height: auto;
      padding-top: 7rem;
    }

    .contact-content {
      padding: 4rem 0 5rem;
    }

    .contact-links {
      grid-template-columns: 1fr;
    }

    .portfolio-footer {
      flex-direction: column;
      text-align: center;
    }
  }
</style>