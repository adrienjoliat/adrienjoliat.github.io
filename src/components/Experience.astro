---
const experiences = [
  {
    period: 'Mar — Sep 2025',
    organization: 'European Space Agency · ESTEC',
    location: 'Noordwijk, The Netherlands',
    role: 'Research Intern — Onboard AI for Earth Observation',
    description:
      'Worked on onboard artificial intelligence for the Copernicus Hyperspectral Imaging Mission for the Environment (CHIME), focusing on hyperspectral marine-anomaly screening under practical mission constraints.',
    highlights: [
      'Built and processed proxy datasets from hyperspectral satellite imagery and designed preprocessing workflows for machine-learning experiments.',
      'Performed spectral feature extraction and selection, trained and validated machine-learning models, and assessed their suitability for onboard screening.',
      'Connected research-oriented ML methods with computational constraints for future intelligent Earth-observation missions.',
    ],
    tags: ['Onboard AI', 'Hyperspectral EO', 'Machine Learning', 'Remote Sensing'],
    accent: 'ESA',
  },
  {
    period: 'Jul — Aug 2024',
    organization: 'Omnidata',
    location: 'Switzerland',
    role: 'Geospatial Data & Application Development',
    description:
      'Worked with geospatial surveying data and contributed to software used in measurement and data-processing workflows.',
    highlights: [
      'Processed geospatial measurement data for surveying workflows.',
      'Contributed to application development and technical data handling.',
    ],
    tags: ['Geospatial Data', 'Data Processing', 'Application Development'],
    accent: 'GEO',
  },
  {
    period: '2019 — 2020',
    organization: 'Swiss Armed Forces',
    location: 'Switzerland',
    role: 'Computer Science · Long Service',
    description:
      'Completed a 300-day long-service period in computer science and received an honor distinction with appointed rank.',
    highlights: [],
    tags: ['Computer Science', 'Systems', 'Teamwork'],
    accent: 'SYS',
  },

  {
  period: '2017 — 2019',
  organization: 'Fédération Internationale de Basketball · FIBA',
  location: 'Switzerland',
  role: 'Basketball Statistician',
  description:
    'Recorded and managed live game statistics for national and international basketball competitions, requiring accuracy, focus, and coordination in a real-time environment.',
  highlights: [],
  tags: ['Live Data', 'Sports', 'Teamwork', 'Volunteering'],
  accent: 'FIBA',
  },
];
---

<section id="experience" class="experience section shell reveal" aria-labelledby="experience-title">
  <div class="section-heading">
    <span>02.</span>
    <h3 id="experience-title">Experience</h3>
  </div>

  <div class="experience-intro">
    <p>
      Professional experience across scientific research, Earth observation,
      geospatial data, and technical systems.
    </p>
  </div>

  <div class="timeline">
    {experiences.map((item) => (
      <article class="experience-row">
        <div class="timeline-meta">
          <p>{item.period}</p>
        </div>
        <span class="timeline-marker" aria-hidden="true"></span>

        <div class="experience-card">
          <div class="experience-card-header">
            <div>
              <p class="experience-kicker">{item.organization}</p>
              <h4>{item.role}</h4>
              <p class="experience-location">{item.location}</p>
            </div>
            <span class="experience-code" aria-hidden="true">{item.accent}</span>
          </div>

          <p class="experience-description">{item.description}</p>

          {item.highlights.length > 0 && (
            <ul class="experience-highlights">
              {item.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          )}

          <div class="experience-tags" aria-label={`${item.organization} technologies and areas`}>
            {item.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .experience { min-height: 100vh; padding-top: 9rem; padding-bottom: 8rem; scroll-margin-top: var(--nav-height); }
  .experience-intro { max-width: 650px; margin-top: 1.4rem; }
  .experience-intro p { margin: 0; color: #718099; font-size: .95rem; line-height: 1.7; }
  .timeline {
    --date-width: 8.5rem;
    --marker-size: 18px;
    --marker-offset: 1.55rem;
    --column-gap: 1.25rem;
    --row-gap: 1.4rem;
    --rail-x: calc(var(--date-width) + var(--column-gap) + var(--marker-size) / 2);
    display: grid;
    gap: var(--row-gap);
    max-width: 980px;
    margin-top: 3.5rem;
  }

  .experience-row {
    position: relative;
    display: grid;
    grid-template-columns: var(--date-width) var(--marker-size) minmax(0, 1fr);
    column-gap: var(--column-gap);
    align-items: start;
  }

  .experience-row:not(:last-child)::before {
    content: "";
    position: absolute;
    left: var(--rail-x);
    top: calc(var(--marker-offset) + var(--marker-size) / 2);
    width: 1px;
    height: calc(100% + var(--row-gap));
    transform: translateX(-50%);
    background: rgba(100,255,218,.22);
    pointer-events: none;
  }

  .timeline-meta {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    padding-top: var(--marker-offset);
    text-align: right;
  }

  .timeline-meta p {
    margin: 0;
    color: #8796ac;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .72rem;
    line-height: var(--marker-size);
  }

  .timeline-marker {
    position: relative;
    z-index: 1;
    grid-column: 2;
    grid-row: 1;
    display: grid;
    place-items: center;
    width: var(--marker-size);
    height: var(--marker-size);
    margin-top: var(--marker-offset);
    border: 1px solid rgba(100,255,218,.55);
    border-radius: 50%;
    background: #06101c;
  }

  .timeline-marker::after {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px rgba(100,255,218,.65);
  }

  .experience-card { grid-column: 3; grid-row: 1; min-width: 0; overflow-wrap: anywhere; position: relative; overflow: hidden; padding: 1.55rem 1.65rem; border: 1px solid rgba(114,183,255,.10); border-radius: 10px; background: linear-gradient(135deg, rgba(10,24,47,.48), rgba(7,16,29,.28)); transition: transform .25s ease, border-color .25s ease, background .25s ease; }
  .experience-card::before { content: ""; position: absolute; left: 0; top: 0; width: 2px; height: 100%; background: linear-gradient(to bottom, rgba(100,255,218,.65), rgba(114,183,255,.08)); opacity: .5; }
  .experience-card:hover { transform: translateY(-3px); border-color: rgba(114,183,255,.19); background: linear-gradient(135deg, rgba(10,24,47,.60), rgba(7,16,29,.34)); }
  .experience-card-header { display: flex; justify-content: space-between; gap: 1.5rem; align-items: flex-start; }
  .experience-kicker { margin: 0 0 .45rem; color: var(--accent); font-family: "SFMono-Regular", Consolas, monospace; font-size: .7rem; letter-spacing: .035em; }
  .experience-card h4 { margin: 0; color: #dce6f3; font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.3; letter-spacing: -.025em; font-weight: 630; }
  .experience-location { margin: .45rem 0 0; color: #65758c; font-size: .74rem; }
  .experience-code { flex: 0 0 auto; padding: .45rem .5rem; border: 1px solid rgba(114,183,255,.12); border-radius: 4px; color: #52667e; font-family: "SFMono-Regular", Consolas, monospace; font-size: .58rem; letter-spacing: .12em; }
  .experience-description { max-width: 760px; margin: 1.3rem 0 0; color: #8d9bb0; font-size: .9rem; line-height: 1.72; }
  .experience-highlights { display: grid; gap: .65rem; margin: 1.2rem 0 0; padding: 0; list-style: none; }
  .experience-highlights li { position: relative; padding-left: 1.2rem; color: #7f8da2; font-size: .82rem; line-height: 1.65; }
  .experience-highlights li::before { content: "›"; position: absolute; left: 0; top: 0; color: var(--accent); font-family: monospace; }
  .experience-tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.35rem; }
  .experience-tags span { padding: .38rem .55rem; border: 1px solid rgba(114,183,255,.09); border-radius: 999px; background: rgba(114,183,255,.025); color: #6f8199; font-family: "SFMono-Regular", Consolas, monospace; font-size: .6rem; }
  @media (max-width: 700px) {
    .experience { min-height: auto; padding-top: 7rem; padding-bottom: 6rem; }
    .timeline {
      --marker-offset: 0px;
      --column-gap: .85rem;
      --row-gap: 1.5rem;
      --rail-x: calc(var(--marker-size) / 2);
    }
    .experience-row {
      grid-template-columns: var(--marker-size) minmax(0, 1fr);
      row-gap: .75rem;
    }
    .timeline-meta { grid-column: 2; text-align: left; }
    .timeline-marker { grid-column: 1; }
    .experience-card { grid-column: 2; grid-row: 2; padding: 1.35rem 1.25rem; }
  }
  @media (max-width: 480px) { .experience-card-header { display: block; } .experience-code { display: inline-block; margin-top: .85rem; } }
</style>
