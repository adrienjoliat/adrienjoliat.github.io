---
const publications = [
  {
    index: '01',
    type: 'MSc Thesis · EPFL / ETH Zürich',
    title: 'Enhancing the spatial resolution of monthly gravity solutions derived from satellite laser ranging',
    subtitle: 'Space Geodesy Lab',
    description:
      'Developed an end-to-end deep-learning pipeline to enhance low-degree satellite laser-ranging gravity solutions toward GRACE-like monthly fields. The work combined scientific preprocessing, custom sequence representations, Transformer/GRU architectures, autoregressive modelling, validation-based checkpointing, and multi-domain evaluation.',
    outcome: 'Accepted and presented · GSTM 2026',
    preview: '/research/master-thesis-preview.webp',
    previewAlt: 'Master’s thesis poster on enhancing monthly gravity solutions from satellite laser ranging, presented at GSTM 2026',
    previewWidth: 991,
    previewHeight: 1400,
    poster: '/research/master-thesis-gstm-2026-poster.pdf',
    tags: ['Transformers', 'GRU', 'Generative Models', 'Scientific ML', 'Space Geodesy'],
  },
  {
    index: '02',
    type: 'First-author paper · IEEE IGARSS 2026',
    title: 'CHIME Onboard AI for Marine-Anomaly Screening',
    subtitle: 'European Space Agency · ESTEC',
    description:
      'Research on intelligent onboard screening for the Copernicus CHIME mission. Built the CHIME-MDset proxy dataset, developed hyperspectral feature-selection workflows and compact linear-SVM models, and evaluated the approach in mission-like conditions.',
    outcome: 'Published · IEEE IGARSS 2026 · Washington, D.C.',
    preview: '/research/chime-preview.webp',
    previewAlt: 'CHIME-like satellite image beside the onboard classification mask from the paper’s CHEES simulation',
    previewWidth: 770,
    previewHeight: 425,
    poster: null,
    tags: ['Hyperspectral EO', 'SVM', 'Feature Selection', 'Onboard AI', 'Remote Sensing'],
  },
];

const researchProjects = [
  {
    index: '03',
    type: 'Research project · ECEO',
    title: 'Hyperbolic representations for airborne change detection',
    subtitle: 'Environmental Computational Science & Earth Observation',
    description:
      'Developed a deep-learning semantic-segmentation approach for airborne imagery using hyperbolic representations to encode hierarchical class structure and investigate alternatives to standard Euclidean feature spaces.',
    outcome: 'Hierarchical representation learning for Earth observation',
    tags: ['Hyperbolic Geometry', 'Semantic Segmentation', 'PyTorch', 'Earth Observation'],
    preview: '/research/hyperbolic-preview.png',
    previewAlt: 'Preview of hyperbolic remote sensing research',
    pdf: '/research/hyperbolic-report.pdf',
    pdfLabel: 'Research Report',
  },
  {
    index: '04',
    type: 'Research project · ESA × MLO',
    title: 'Deep learning for coronal-jet identification',
    subtitle: 'Solar Physics & Space Weather',
    description:
      'Applied deep-learning-based image and video object detection to solar observations for identifying coronal jets, combining computer vision with a scientific space-weather application.',
    outcome: 'Scientific computer vision for solar observations',
    tags: ['Computer Vision', 'Object Detection', 'Video', 'Solar Physics'],
    preview: '/research/coronal-preview.png',
    previewAlt: 'Preview of coronal jet identification research',
    publicationUrl: 'https://infoscience.epfl.ch/entities/publication/0930ea7d-e8f4-4dec-98a6-f8656bcc66df/studentdetails',
    publicationLabel: 'EPFL Infoscience',
  },
];
---

<section id="research" class="research section shell reveal" aria-labelledby="research-title">
  <div class="section-heading">
    <span>03.</span>
    <h3 id="research-title">Research</h3>
  </div>


  <div class="research-block">
    <div class="research-subheading">
      <span>Publications</span>
    </div>

    <div class="research-grid">
      {publications.map((project) => (
        <article class="research-card">
          <div class="research-topline">
            <span>{project.index}</span>
            <p>{project.type}</p>
          </div>

          <div class="project-layout">
            <div class="research-copy">
              <p class="research-subtitle">{project.subtitle}</p>
              <h4>{project.title}</h4>
              <p class="research-description">{project.description}</p>

              <div class="research-outcome">
                <i aria-hidden="true"></i>
                <span>{project.outcome}</span>
              </div>

              {project.poster && (
                <div class="research-actions">
                  <a
                    class="research-link"
                    href={project.poster}
                    download="Adrien-Joliat-GSTM-2026-Poster.pdf"
                    aria-label="Download the master's thesis poster presented at GSTM 2026 (PDF)"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" width="15" height="15">
                      <path
                        d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span>Download poster</span>
                    <span class="research-link-type">PDF</span>
                  </a>
                </div>
              )}

              <div class="research-tags">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>

            {project.poster ? (
              <a
                class="research-preview publication-preview"
                href={project.poster}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View the master's thesis poster presented at GSTM 2026 (opens in a new tab)"
              >
                <img src={project.preview} alt={project.previewAlt} width={project.previewWidth} height={project.previewHeight} loading="lazy" />
              </a>
            ) : (
              <div class="research-preview publication-preview">
                <img src={project.preview} alt={project.previewAlt} width={project.previewWidth} height={project.previewHeight} loading="lazy" />
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="research-block">
    <div class="research-subheading">
      <span>Selected Research Projects</span>
    </div>

    <div class="research-grid">
      {researchProjects.map((project) => (
        <article class="research-card">
          <div class="research-topline">
            <span>{project.index}</span>
            <p>{project.type}</p>
          </div>

          <div class="project-layout">
            <div class="research-copy">
              <p class="research-subtitle">{project.subtitle}</p>
              <h4>{project.title}</h4>
              <p class="research-description">{project.description}</p>

              <div class="research-outcome">
                <i aria-hidden="true"></i>
                <span>{project.outcome}</span>
              </div>

              <div class="research-actions">
                {project.pdf ? (
                  <a
                    class="research-link"
                    href={project.pdf}
                    download
                    aria-label={`Download ${project.pdfLabel}: ${project.title}`}
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" width="15" height="15">
                      <path
                        d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>

                    <span>{project.pdfLabel}</span>
                    <span class="research-link-type">PDF</span>
                  </a>
                ) : project.publicationUrl ? (
                  <a
                    class="research-link"
                    href={project.publicationUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Open ${project.title} on ${project.publicationLabel}`}
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" width="15" height="15">
                      <path
                        d="M14 5h5v5M10 14 19 5M19 14v5H5V5h5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>

                    <span>{project.publicationLabel}</span>
                    <span class="research-link-type">LINK</span>
                  </a>
                ) : (
                  <span class="research-link research-link--disabled">
                    Report unavailable
                  </span>
                )}
              </div>

              <div class="research-tags">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>

            <div class="research-preview">
              <img src={project.preview} alt={project.previewAlt} loading="lazy" />
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .research {
    min-height: 100vh;
    padding-top: 9rem;
    padding-bottom: 8rem;
    scroll-margin-top: var(--nav-height);
  }

  .research-intro {
    max-width: 700px;
    margin-top: 1.4rem;
  }

  .research-intro p {
    margin: 0;
    color: #718099;
    font-size: .95rem;
    line-height: 1.7;
  }

  .research-block {
    margin-top: 3.25rem;
  }

  .research-subheading {
    margin-bottom: 1rem;
  }

  .research-subheading span {
    color: var(--accent);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .72rem;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .research-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .research-card {
    min-width: 0;
    overflow-wrap: anywhere;
    position: relative;
    overflow: hidden;
    padding: 1.45rem;
    border: 1px solid rgba(114,183,255,.10);
    border-radius: 10px;
    background:
      radial-gradient(circle at 85% 20%, rgba(65,141,209,.08), transparent 28%),
      linear-gradient(145deg, rgba(10,24,47,.48), rgba(7,16,29,.28));
    transition: transform .25s ease, border-color .25s ease;
  }

  .research-card:hover {
    transform: translateY(-3px);
    border-color: rgba(114,183,255,.20);
  }
  .research-link {
  text-decoration: none;
  }

  .research-link-type {
    margin-left: .15rem;
    padding-left: .55rem;
    border-left: 1px solid rgba(148,163,184,.15);
    color: #52677f;
    font-size: .55rem;
    letter-spacing: .08em;
  }
  .research-topline {
    display: flex;
    align-items: center;
    gap: .7rem;
    padding-bottom: .9rem;
    border-bottom: 1px solid rgba(148,163,184,.08);
  }

  .research-topline > span {
    color: var(--accent);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .64rem;
  }

  .research-topline p {
    margin: 0;
    color: #62758d;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .62rem;
    letter-spacing: .02em;
  }

  .research-copy {
    min-width: 0;
    padding-top: 1.2rem;
  }

  .research-subtitle {
    margin: 0 0 .6rem;
    color: var(--accent);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .68rem;
  }

  .research-card h4 {
    margin: 0;
    color: #dbe6f3;
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: 1.24;
    letter-spacing: -.035em;
    font-weight: 650;
  }

  .research-description {
    max-width: 90ch;
    margin: 1rem 0 0;
    color: #8795aa;
    font-size: .85rem;
    line-height: 1.7;
  }

  .research-outcome {
    display: flex;
    align-items: center;
    gap: .6rem;
    margin-top: 1.1rem;
    color: #9cabc0;
    font-size: .74rem;
  }

  .research-outcome i {
    display: block;
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px rgba(100,255,218,.45);
  }

  .research-actions {
    margin-top: 1.15rem;
  }

  .research-link {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .62rem .82rem;
    border: 1px solid rgba(100,255,218,.22);
    border-radius: 6px;
    background: rgba(100,255,218,.03);
    color: #a7b8cd;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .64rem;
    transition: color .2s ease, border-color .2s ease, background .2s ease, transform .2s ease;
  }

  .research-link:hover {
    color: var(--accent);
    border-color: rgba(100,255,218,.42);
    background: rgba(100,255,218,.06);
    transform: translateY(-2px);
  }

  .research-link--disabled {
    cursor: default;
    color: #73839a;
    border-color: rgba(148,163,184,.12);
    background: rgba(148,163,184,.04);
  }

  .research-link--disabled:hover {
    color: #73839a;
    border-color: rgba(148,163,184,.12);
    background: rgba(148,163,184,.04);
    transform: none;
  }

  .research-tags {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin-top: 1.2rem;
  }

  .research-tags span {
    padding: .38rem .52rem;
    border: 1px solid rgba(114,183,255,.09);
    border-radius: 999px;
    color: #6f8198;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .58rem;
  }

  .project-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 1.5rem;
    align-items: center;
  }

  .research-preview {
    justify-self: end;
    width: 220px;
    height: 150px;
    overflow: hidden;
    border: 1px solid rgba(114,183,255,.12);
    border-radius: 8px;
    background: rgba(7,16,29,.55);
    box-shadow: 0 10px 35px rgba(0,0,0,.18);
  }

  .research-preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .project-layout {
      grid-template-columns: 1fr;
    }

    .research-preview {
      justify-self: start;
      width: min(100%, 320px);
      height: auto;
      aspect-ratio: 4 / 3;
      margin-top: .5rem;
    }
  }

  @media (max-width: 700px) {
    .research {
      min-height: auto;
      padding-top: 7rem;
      padding-bottom: 6rem;
    }

    .research-block {
      margin-top: 2.6rem;
    }

    .research-card {
      padding: 1.3rem 1.2rem;
    }
  }
  /* Preserve complete poster pages and figure labels at every breakpoint. */
  .publication-preview {
    display: block;
    height: auto;
    aspect-ratio: auto;
    margin-top: 1.2rem;
    background: #fff;
  }

  .publication-preview img {
    height: auto;
    object-fit: contain;
  }

  a.publication-preview:hover {
    border-color: rgba(100,255,218,.55);
  }
</style>