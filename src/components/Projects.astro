---
const projects = [
  {
    index: '01',
    category: 'Agentic AI · Systems Engineering',
    title: 'Agentic Mission Control',
    subtitle: 'AI agent orchestration & observability',
    description:
      'A local-first operations dashboard for orchestrating and monitoring AI agents. Connected to an OpenClaw runtime through a privacy-conscious server interface, it exposes agent state, missions, activity, runtime health and aggregate telemetry while keeping sensitive session data private.',
    tags: [
      'AI Agents',
      'Next.js',
      'TypeScript',
      'OpenClaw',
      'LLMs',
      'Agent Orchestration',
    ],
    preview: '/projects/agentic-interface.png',
    previewAlt: 'Agentic Mission Control interface for orchestrating AI agents',
    github: 'https://github.com/adrienjoliat/Agentic-Interface',
    live: null,
    status: 'Active development',
    reverse: false,
  },
  {
    index: '02',
    category: 'Natural Language Processing · Web Application',
    title: 'Blue Click, Red Click',
    subtitle: 'Political-bias classification with a fine-tuned BERT model',
    description:
      'An interactive web application for classifying the political orientation of news articles using a fine-tuned BERT model, combining natural language processing, transformer fine-tuning and a user-facing web interface.',
    tags: [
      'BERT',
      'NLP',
      'Transformers',
      'Fine-tuning',
      'Text Classification',
      'Web App',
    ],
    preview: '/projects/blue-click-red-click.png',
    previewAlt: 'Blue Click, Red Click political-bias classification web application',
    github: 'https://github.com/WassimMaj/team_MiaouMiaou',
    live: 'https://wassimmaj.github.io/team_MiaouMiaou/',
    status: 'Deployed',
    reverse: true,
  },
];
---

<section
  id="projects"
  class="projects section shell reveal"
  aria-labelledby="projects-title"
>
  <div class="section-heading">
    <span>04.</span>
    <h3 id="projects-title">Projects</h3>
  </div>

  <div class="projects-intro">
    <p>
      Selected systems and applications built beyond my core research work,
      spanning agentic AI, software engineering and applied machine learning.
    </p>
  </div>

  <div class="projects-list">
    {projects.map((project) => (
      <article
        class:list={[
          'project-card',
          project.reverse && 'project-card--reverse',
        ]}
      >
        <div class="project-media">
          <div class="project-browser">
            <div class="browser-bar" aria-hidden="true">
              <div class="browser-dots">
                <i></i>
                <i></i>
                <i></i>
              </div>

              <span>{project.title}</span>
            </div>

            <div class="project-image">
              <img
                src={project.preview}
                alt={project.previewAlt}
                loading="lazy"
              />
            </div>
          </div>

          <span class="project-status">
            <i aria-hidden="true"></i>
            {project.status}
          </span>
        </div>

        <div class="project-copy">
          <div class="project-topline">
            <span>{project.index}</span>
            <p>{project.category}</p>
          </div>

          <p class="project-subtitle">{project.subtitle}</p>

          <h4>{project.title}</h4>

          <p class="project-description">
            {project.description}
          </p>

          <div class="project-actions">
            {project.live && (
              <a
                class="project-link project-link--primary"
                href={project.live}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open live ${project.title} project`}
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  width="15"
                  height="15"
                >
                  <path
                    d="M14 5h5v5M10 14 19 5M19 14v5H5V5h5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>

                <span>Live project</span>
              </a>
            )}

            <a
              class="project-link"
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${project.title} repository on GitHub`}
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                width="16"
                height="16"
              >
                <path
                  fill="currentColor"
                  d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.85.09-.66.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.35 9.35 0 0 1 12 6.93a9.3 9.3 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.8 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"
                />
              </svg>

              <span>GitHub</span>
            </a>
          </div>

          <div class="project-tags" aria-label={`${project.title} technologies`}>
            {project.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .projects {
    min-height: 100vh;
    padding-top: 9rem;
    padding-bottom: 8rem;
    scroll-margin-top: var(--nav-height);
  }

  .projects-intro {
    max-width: 700px;
    margin-top: 1.4rem;
  }

  .projects-intro p {
    margin: 0;
    color: #718099;
    font-size: .95rem;
    line-height: 1.7;
  }

  .projects-list {
    display: grid;
    gap: clamp(4.5rem, 8vw, 7rem);
    margin-top: 4rem;
  }

  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .project-card--reverse .project-media {
    order: 2;
  }

  .project-card--reverse .project-copy {
    order: 1;
  }

  .project-media {
    position: relative;
    min-width: 0;
  }

  .project-browser {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(114,183,255,.15);
    border-radius: 10px;
    background: rgba(7,16,29,.65);
    box-shadow:
      0 25px 60px rgba(0,0,0,.28),
      0 0 50px rgba(65,141,209,.055);
    transition:
      transform .3s ease,
      border-color .3s ease,
      box-shadow .3s ease;
  }

  .project-browser::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        135deg,
        rgba(100,255,218,.045),
        transparent 28%,
        transparent 68%,
        rgba(114,183,255,.045)
      );
  }

  .project-card:hover .project-browser {
    transform: translateY(-4px);
    border-color: rgba(114,183,255,.28);
    box-shadow:
      0 28px 70px rgba(0,0,0,.34),
      0 0 60px rgba(65,141,209,.08);
  }

  .browser-bar {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr) 60px;
    align-items: center;
    min-height: 34px;
    padding: 0 .8rem;
    border-bottom: 1px solid rgba(148,163,184,.08);
    background: rgba(5,8,16,.75);
  }

  .browser-bar > span {
    overflow: hidden;
    color: #51637b;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .55rem;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .browser-dots {
    display: flex;
    gap: .3rem;
  }

  .browser-dots i {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(148,163,184,.22);
  }

  .project-image {
  position: relative;
  overflow: hidden;
  background: #07101d;
}

.project-image img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  transition:
    transform .45s ease,
    filter .3s ease;
}

  .project-card:hover .project-image img {
  transform: none;
}

  .project-status {
    position: absolute;
    right: 1rem;
    bottom: -1rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .55rem .7rem;
    border: 1px solid rgba(100,255,218,.15);
    border-radius: 5px;
    background: rgba(5,13,23,.94);
    box-shadow: 0 10px 30px rgba(0,0,0,.28);
    color: #7f91a8;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .58rem;
  }

  .project-status i {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 9px rgba(100,255,218,.6);
  }

  .project-copy {
    min-width: 0;
    overflow-wrap: anywhere;
    position: relative;
  }

  .project-topline {
    display: flex;
    align-items: center;
    gap: .65rem;
    margin-bottom: 1.2rem;
  }

  .project-topline > span {
    color: var(--accent);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .64rem;
  }

  .project-topline p {
    margin: 0;
    color: #62758d;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .62rem;
  }

  .project-subtitle {
    margin: 0 0 .55rem;
    color: var(--accent);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .68rem;
  }

  .project-copy h4 {
    margin: 0;
    color: #dce6f3;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.12;
    letter-spacing: -.045em;
    font-weight: 650;
  }

  .project-description {
    margin: 1.25rem 0 0;
    color: #8795aa;
    font-size: .9rem;
    line-height: 1.75;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    margin-top: 1.5rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .62rem .8rem;
    border: 1px solid rgba(114,183,255,.15);
    border-radius: 6px;
    background: rgba(114,183,255,.025);
    color: #9eafc4;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .64rem;
    text-decoration: none;
    transition:
      color .2s ease,
      border-color .2s ease,
      background .2s ease,
      transform .2s ease;
  }

  .project-link:hover {
    color: var(--accent);
    border-color: rgba(100,255,218,.38);
    background: rgba(100,255,218,.05);
    transform: translateY(-2px);
  }

  .project-link--primary {
    border-color: rgba(100,255,218,.22);
    background: rgba(100,255,218,.035);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: .42rem;
    margin-top: 1.5rem;
  }

  .project-tags span {
    padding: .38rem .52rem;
    border: 1px solid rgba(114,183,255,.09);
    border-radius: 999px;
    color: #6f8198;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: .58rem;
  }

  @media (max-width: 900px) {
    .project-card {
      grid-template-columns: 1fr;
      gap: 2.3rem;
    }

    .project-card--reverse .project-media,
    .project-card--reverse .project-copy {
      order: initial;
    }

    .project-media {
      max-width: 720px;
    }

    .project-copy {
      max-width: 720px;
    }
  }

  @media (max-width: 700px) {
    .projects {
      min-height: auto;
      padding-top: 7rem;
      padding-bottom: 6rem;
    }

    .projects-list {
      gap: 4rem;
      margin-top: 3rem;
    }

    .project-copy h4 {
      font-size: 1.55rem;
    }

    .project-status {
      right: .7rem;
      bottom: -.8rem;
    }
  }

  @media (max-width: 480px) {
    .browser-bar {
      grid-template-columns: 45px minmax(0, 1fr) 45px;
    }

    .project-actions {
      align-items: stretch;
    }

    .project-link {
      justify-content: center;
    }
  }
</style>