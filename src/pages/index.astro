---
import '../styles/global.css';

const title = 'Adrien Joliat | Machine Learning Engineer & Applied Researcher';
const description = 'Portfolio of Adrien Joliat — machine learning engineer and applied researcher working across scientific machine learning, computer vision, Earth observation, generative AI, and intelligent systems.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050810" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <section class="foundation" aria-labelledby="page-title">
        <p class="eyebrow">Portfolio / Foundation</p>
        <h1 id="page-title">Adrien Joliat.</h1>
        <h2>Machine Learning Engineer & Applied Researcher.</h2>
        <p>
          Building intelligent systems at the intersection of machine learning,
          science, and engineering. The full portfolio is currently being built.
        </p>
        <div class="status">Phase 1 — infrastructure ready</div>
      </section>
    </main>
  </body>
</html>
